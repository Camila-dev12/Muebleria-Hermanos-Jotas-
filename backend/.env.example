# Copiar este archivo como .env (en esta misma carpeta) y completar los valores.
# El archivo .env NO se sube al repositorio.

# Puerto del servidor (opcional, por defecto 3001)
PORT=3001

# URI de conexión de MongoDB Atlas (obligatoria).
# Se obtiene en Atlas > Database > Connect > Drivers.
# Reemplazar <usuario>, <password> y <cluster>. El nombre de la base va después de la barra.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/muebleria-jota

# Orígenes (frontends) que pueden llamar a la API, separados por comas (opcional).
# En producción (Render) poner la URL del frontend, ej. https://mi-sitio.vercel.app
# Si no se define, se acepta cualquier origen (útil en desarrollo).
# CORS_ORIGINS=https://mi-sitio.vercel.app

# DNS para resolver la URI de Atlas (opcional).
# Descomentar solo si al iniciar aparece el error "querySrv ECONNREFUSED".
# DNS_SERVERS=8.8.8.8,1.1.1.1
