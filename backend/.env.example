# Copiar este archivo como .env (en esta misma carpeta) y completar los valores.
# El archivo .env NO se sube al repositorio.

# Puerto del servidor (opcional, por defecto 3001)
PORT=3001

# URI de conexión de MongoDB Atlas (obligatoria).
# Se obtiene en Atlas > Database > Connect > Drivers.
# Reemplazar <usuario>, <password> y <cluster>. El nombre de la base va después de la barra.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/muebleria-jota?retryWrites=true&w=majority
